<!DOCTYPE html><html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#000000">
  <title>Música Dark</title>  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #000;
      color: #eee;
      font-family: Arial, Helvetica, sans-serif;
    }

    .app {
      max-width: 700px;
      min-height: 100vh;
      margin: auto;
      padding: 22px 16px 145px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .sub {
      margin-top: 4px;
      color: #777;
      font-size: 10px;
      letter-spacing: 3px;
    }

    button {
      border: 0;
      border-radius: 12px;
      padding: 11px 14px;
      color: #fff;
      background: #151515;
      font-weight: 700;
      cursor: pointer;
    }

    button:active {
      transform: scale(0.96);
    }

    #pick {
      background: #b71c1c;
    }

    .search {
      width: 100%;
      margin-bottom: 12px;
      padding: 14px;
      border: 1px solid #222;
      border-radius: 12px;
      outline: none;
      background: #0d0d0d;
      color: #fff;
      font-size: 15px;
    }

    .search:focus {
      border-color: #b71c1c;
    }

    .track {
      display: flex;
      align-items: center;
      padding: 12px;
      border-radius: 12px;
      cursor: pointer;
    }

    .track:hover,
    .track.active {
      background: #111;
    }

    .cover {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      margin-right: 12px;
      border-radius: 9px;
      background: #151515;
      font-size: 20px;
    }

    .info {
      min-width: 0;
      flex: 1;
    }

    .title {
      overflow: hidden;
      font-weight: 700;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .artist {
      margin-top: 4px;
      color: #888;
      font-size: 12px;
    }

    .empty {
      padding: 60px 20px;
      color: #777;
      text-align: center;
      line-height: 1.6;
    }

    .player {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 5;
      padding: 12px 16px;
      border-top: 1px solid #222;
      background: #050505;
    }

    .player-inner {
      max-width: 700px;
      margin: auto;
    }

    .now {
      display: flex;
      align-items: center;
      margin-bottom: 8px;
    }

    .nowtext {
      min-width: 0;
      flex: 1;
    }

    .bar {
      height: 5px;
      overflow: hidden;
      border-radius: 5px;
      background: #252525;
      cursor: pointer;
    }

    .fill {
      width: 0;
      height: 100%;
      background: #b71c1c;
    }

    .times {
      display: flex;
      justify-content: space-between;
      margin-top: 5px;
      color: #777;
      font-size: 10px;
    }

    .controls {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 5px;
    }

    .controls button {
      background: transparent;
      font-size: 21px;
    }

    .play {
      width: 52px;
      height: 52px;
      padding: 0;
      border-radius: 50%;
      background: #b71c1c !important;
    }

    input[type="file"] {
      display: none;
    }

    @media (max-width: 480px) {
      header {
        align-items: flex-start;
      }

      .logo {
        font-size: 21px;
      }

      #pick {
        padding: 10px;
        font-size: 12px;
      }
    }
  </style></head><body>  <div class="app"><header>
  <div>
    <div class="logo">MÚSICA DARK</div>
    <div class="sub">ROCK • OFFLINE</div>
  </div>

  <button id="pick">＋ MÚSICAS</button>

  <input
    id="files"
    type="file"
    accept="audio/*"
    multiple
  >
</header>

<input
  id="search"
  class="search"
  type="search"
  placeholder="Buscar música..."
>

<div id="list"></div>

  </div>  <div class="player"><div class="player-inner">

  <div class="now">

    <div class="cover">
      ♪
    </div>

    <div class="nowtext">

      <div id="nowTitle" class="title">
        Nenhuma música
      </div>

      <div id="nowArtist" class="artist">
        Escolha músicas do seu celular
      </div>

    </div>

  </div>


  <div id="bar" class="bar">
    <div id="fill" class="fill"></div>
  </div>


  <div class="times">

    <span id="cur">
      0:00
    </span>

    <span id="dur">
      0:00
    </span>

  </div>


  <div class="controls">

    <button id="prev">
      ⏮
    </button>

    <button id="play" class="play">
      ▶
    </button>

    <button id="next">
      ⏭
    </button>

  </div>

</div>

  </div><audio id="audio"></audio>

  <script>

    const $ = id => document.getElementById(id);

    const files = $("files");
    const audio = $("audio");

    let tracks = [];
    let index = -1;
    let urls = [];


    /*
      ABRIR SELETOR DE MÚSICAS
    */

    $("pick").onclick = () => {
      files.click();
    };


    /*
      CARREGAR MÚSICAS
    */

    files.onchange = () => {

      tracks = [...files.files]
        .filter(file => file.type.startsWith("audio/"))
        .map(file => ({
          file: file,
          title: file.name.replace(/\.[^/.]+$/, "")
        }));

      urls = [];

      render();

      if (tracks.length) {
        load(0, false);
      }

    };


    /*
      PESQUISA
    */

    $("search").oninput = render;


    /*
      MOSTRAR LISTA
    */

    function render() {

      const query = $("search")
        .value
        .toLowerCase();

      const filtered = tracks
        .map((track, i) => ({
          ...track,
          i
        }))
        .filter(track =>
          track.title
            .toLowerCase()
            .includes(query)
        );


      if (!filtered.length) {

        $("list").innerHTML = `
          <div class="empty">

            <b>Seu som começa aqui.</b>

            <br><br>

            Toque em
            <b>＋ MÚSICAS</b>
            e escolha os arquivos de áudio do celular.

          </div>
        `;

      } else {

        $("list").innerHTML = filtered
          .map(track => `

            <div
              class="track ${track.i === index ? "active" : ""}"
              data-i="${track.i}"
            >

              <div class="cover">
                ♪
              </div>

              <div class="info">

                <div class="title">
                  ${escapeHTML(track.title)}
                </div>

                <div class="artist">
                  Arquivo local
                </div>

              </div>

            </div>

          `)
          .join("");


        document
          .querySelectorAll(".track")
          .forEach(element => {

            element.onclick = () => {

              load(
                Number(element.dataset.i),
                true
              );

            };

          });

      }

    }


    /*
      SEGURANÇA PARA NOMES DE ARQUIVOS
    */

    function escapeHTML(text) {

      return text.replace(
        /[&<>"]/g,
        character => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;"
        })[character]
      );

    }


    /*
      CARREGAR UMA MÚSICA
    */

    function load(i, autoplay) {

      if (!tracks[i]) {
        return;
      }

      index = i;


      if (!urls[i]) {

        urls[i] =
          URL.createObjectURL(
            tracks[i].file
          );

      }


      audio.src = urls[i];

      audio.load();


      $("nowTitle").textContent =
        tracks[i].title;

      $("nowArtist").textContent =
        "Arquivo local";


      render();


      if (autoplay) {

        audio.play();

        $("play").textContent = "Ⅱ";

      }

    }


    /*
      PLAY / PAUSE
    */

    $("play").onclick = () => {

      if (
        index < 0 &&
        tracks.length
      ) {

        load(0, false);

      }


      if (!audio.src) {
        return;
      }


      if (audio.paused) {

        audio.play();

        $("play").textContent = "Ⅱ";

      } else {

        audio.pause();

        $("play").textContent = "▶";

      }

    };


    /*
      MÚSICA ANTERIOR
    */

    $("prev").onclick = () => {

      if (!tracks.length) {
        return;
      }

      const previous =
        index > 0
          ? index - 1
          : tracks.length - 1;

      load(previous, true);

    };


    /*
      PRÓXIMA MÚSICA
    */

    $("next").onclick = () => {

      if (!tracks.length) {
        return;
      }

      const next =
        index + 1 < tracks.length
          ? index + 1
          : 0;

      load(next, true);

    };


    /*
      QUANDO A MÚSICA TERMINAR
    */

    audio.onended = () => {

      $("next").click();

    };


    /*
      ATUALIZAR BARRA DE PROGRESSO
    */

    audio.ontimeupdate = () => {

      const percentage =
        audio.duration
          ? (audio.currentTime / audio.duration) * 100
          : 0;

      $("fill").style.width =
        percentage + "%";


      $("cur").textContent =
        formatTime(audio.currentTime);

    };


    /*
      DURAÇÃO
    */

    audio.onloadedmetadata = () => {

      $("dur").textContent =
        formatTime(audio.duration);

    };


    /*
      CLICAR NA BARRA
    */

    $("bar").onclick = event => {

      if (!audio.duration) {
        return;
      }

      const width =
        $("bar").clientWidth;

      const position =
        event.offsetX / width;

      audio.currentTime =
        position * audio.duration;

    };


    /*
      FORMATAR TEMPO
    */

    function formatTime(seconds) {

      if (!isFinite(seconds)) {
        return "0:00";
      }

      seconds = Math.floor(seconds);

      const minutes =
        Math.floor(seconds / 60);

      const remaining =
        String(seconds % 60)
          .padStart(2, "0");

      return minutes + ":" + remaining;

    }


    /*
      INICIAR
    */

    render();

  </script></body>
</html>
